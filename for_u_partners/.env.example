# API Configuration
# Base URL for authentication and app API endpoints
AUTH_ENDPOINT=https://foryou.cilassocies.com/api

# Mapbox Configuration
# Get your tokens from https://account.mapbox.com/access-tokens/
MAPBOX_PUBLIC_TOKEN=your_mapbox_public_token_here
MAPBOX_PRIVATE_TOKEN=your_mapbox_private_token_here
MAPBOX_URL=https://api.mapbox.com/styles/v1/mapbox/streets-v11/tiles/256/{z}/{x}/{y}@2x?access_token=your_mapbox_private_token_here

# Google Maps API (optional)
# Get your API key from https://console.cloud.google.com/
GOOGLE_API_TOKEN=your_google_api_token_here
